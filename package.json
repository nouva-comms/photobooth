{
  "name": "005_photobooth",
  "version": "1.0.0",
  "description": "Photobooth application with Electron, Vue, Prisma",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite --config vite.config.ts",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "electron:build": "electron-builder",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "electron",
    "vue",
    "photobooth",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^8.3.1",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^18.0.3",
    "nodemailer": "^6.10.1",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "type": "commonjs",
  "build": {
    "appId": "com.nouva.photobooth",
    "productName": "NOUVA Photobooth",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "prisma/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      },
      {
        "from": "prisma/migrations",
        "to": "prisma/migrations"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
